{
  "name": "afterpo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval:dataset": "node week4/generate-dataset.mjs",
    "eval:validate": "node week4/evaluate.mjs --validate-only",
    "eval:sync": "node week4/sync-langsmith-dataset.mjs",
    "eval:baseline": "node week4/evaluate.mjs --variant=baseline-v1",
    "eval:improved": "node week4/evaluate.mjs --variant=evidence-enriched-v2",
    "eval:experiment:baseline": "node week4/evaluate.mjs --variant=baseline-v1 --langsmith-experiment",
    "eval:experiment:improved": "node week4/evaluate.mjs --variant=evidence-enriched-v2 --langsmith-experiment"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "langsmith": "^0.10.1",
    "lucide-react": "^0.545.0",
    "openai": "^7.10.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^2.15.2",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "~5.9.3"
  }
}
