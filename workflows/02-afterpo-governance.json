{
  "name": "AfterPO 02 — Governance Gate",
  "nodes": [
    { "parameters": {}, "id": "manual", "name": "Receive Proof Packet", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [-600, 0] },
    {
      "parameters": {
        "jsCode": "const input=$json.governance_request?$json:{id:'INC-004338',supplier_share:60,confidence:0.87,work_cost:92000,evidence:['INC-004338','KB-991','CHG-00171'],governance_request:{action:'POST_LEDGER_ENTRY',risk_tier:3,financial_effect:144000}}; const g=input.governance_request; const failures=[]; if(!input.evidence?.length) failures.push('NO_EVIDENCE'); if(input.confidence<0.75) failures.push('LOW_CONFIDENCE'); if(g.action==='ISSUE_PAYMENT') failures.push('PROHIBITED_ACTION'); let decision='ALLOW'; if(failures.length) decision='BLOCK'; else if(g.risk_tier>=3||g.financial_effect>=200000||input.supplier_share>0&&input.supplier_share<100) decision='APPROVAL_REQUIRED'; return [{json:{...input,governance:{decision,failures,policy_version:'1.3',separation_of_duties:true,evaluated_at:new Date().toISOString()}}}];"
      },
      "id": "policy",
      "name": "Policy-as-Code Evaluation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-360, 0]
    },
    {
      "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "id": "needs-review", "leftValue": "={{ $json.governance.decision }}", "rightValue": "APPROVAL_REQUIRED", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "options": {} },
      "id": "approval-if",
